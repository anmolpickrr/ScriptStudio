# ─── Copy to backend/.env for local development (never commit the real file) ───

# Runtime
APP_ENV=development                 # production on Cloud Run (enables secure cookies, HSTS, hides /api/docs)
PUBLIC_BASE_URL=                    # https://<your-service>.run.app in production (set by infra/deploy.sh)

# AI
LLM_PROVIDER=openai                 # openai | demo (demo = no AI calls, placeholder scripts, for UI testing)
OPENAI_API_KEY=                     # required when LLM_PROVIDER=openai
MODEL_CREATIVE=gpt-5                # concepts, beat sheet, writing, revisions
MODEL_CRITIC=gpt-5                  # concept choice + editorial review
MODEL_EXTRACT=gpt-5-mini            # product facts, brief parsing, accuracy check
REASONING_EFFORT=medium             # low | medium | high
LLM_TIMEOUT_SEC=300

# Auth
AUTH_MODE=none                      # anonymous = open link, private workspace per browser (default for public deploys)
                                    # google    = Google sign-in (needs GOOGLE_CLIENT_ID)
                                    # none      = single local admin user (development only)
ADMIN_PASSCODE=                     # anonymous mode: unlocks house-format editing for whoever enters it
GOOGLE_CLIENT_ID=                   # OAuth "Web application" client ID (see docs/DEPLOYMENT.md)
SESSION_SECRET=                     # long random string; `python -c "import secrets;print(secrets.token_hex(32))"`
ADMIN_EMAILS=                       # comma-separated; admins edit the house format and library
ALLOWED_EMAIL_DOMAINS=              # e.g. youragency.com,client.com — empty = any Google account may sign in
ALLOWED_EMAILS=                     # individual addresses allowed in addition to the domains
DAILY_JOB_LIMIT=15                  # generations + revisions per user/browser per day (admins exempt); 0 = unlimited
GLOBAL_DAILY_LIMIT=200              # whole-app cap per day — protects your OpenAI budget; 0 = unlimited
MAX_CONCURRENT_JOBS=3               # scripts generated in parallel when not using Cloud Tasks

# Storage
STORE_BACKEND=local                 # local (JSON files in LOCAL_STORE_DIR) | firestore
LOCAL_STORE_DIR=.data
GOOGLE_CLOUD_PROJECT=

# Background processing (production): Cloud Tasks queue calling back into this service
CLOUD_TASKS_QUEUE=                  # projects/<project>/locations/<region>/queues/<queue>
TASKS_SERVICE_ACCOUNT=              # service account Cloud Tasks signs its OIDC token as
WORKER_URL=                         # optional; defaults to PUBLIC_BASE_URL

# Google Docs
GDRIVE_FOLDER_ID=                   # only used when exporting with server credentials (AUTH_MODE=none)
                                    # Without GOOGLE_CLIENT_ID, users export Word (.docx), which opens in Google Docs

# Frontend location (the Docker image sets this for you)
STATIC_DIR=../frontend/dist
