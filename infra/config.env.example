# Copy to infra/config.env and fill in. Used by setup-gcp.sh and deploy.sh.
PROJECT_ID=your-gcp-project-id
REGION=asia-south1                  # Mumbai; pick the region closest to your team
SERVICE=scriptwright
GITHUB_REPO=your-org/scriptwright   # enables keyless deploys from GitHub Actions

# App settings (non-secret). Secrets go to Secret Manager via setup-gcp.sh.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
ADMIN_EMAILS=you@yourcompany.com
ALLOWED_EMAIL_DOMAINS=              # empty = anyone with a Google account can sign in
ALLOWED_EMAILS=
DAILY_JOB_LIMIT=15
MODEL_CREATIVE=gpt-5
MODEL_CRITIC=gpt-5
MODEL_EXTRACT=gpt-5-mini
REASONING_EFFORT=medium
LLM_PROVIDER=openai
