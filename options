{"platforms":{"instagram_reels":{"label":"Instagram Reels","aspect":"9:16","durations":[15,30,45,60],"hook_window_sec":2.0,"max_shot_sec":4.0,"notes":"Sound-on but caption every spoken line. Keep text out of the bottom 20% and right edge (UI overlays). Native, handheld or creator-shot feel beats glossy ad look.","cta_style":"Tap 'Shop Now' / link in bio / save this for later"},"tiktok":{"label":"TikTok","aspect":"9:16","durations":[15,21,30,45,60],"hook_window_sec":1.5,"max_shot_sec":3.5,"notes":"Creator-first, talk-to-camera works. Trending-sound friendly. Text in the safe zone, avoid bottom 25% and right 15%. Fast pattern interrupts.","cta_style":"Tap the orange cart / link in bio"},"youtube_shorts":{"label":"YouTube Shorts","aspect":"9:16","durations":[15,30,45,60],"hook_window_sec":2.0,"max_shot_sec":4.0,"notes":"Loopable endings perform well. Keep text above the bottom 25%.","cta_style":"Tap the product sticker / check the link"},"youtube":{"label":"YouTube (in-stream)","aspect":"16:9","durations":[15,30,60,90],"hook_window_sec":5.0,"max_shot_sec":6.0,"notes":"Brand and product must land before the 5s skip. Can carry a fuller story.","cta_style":"Visit / Shop now via the companion banner"},"meta_feed":{"label":"Meta Feed (FB/IG)","aspect":"4:5","durations":[10,15,30],"hook_window_sec":2.0,"max_shot_sec":4.0,"notes":"Most viewers watch muted: the story must work with sound off via supers.","cta_style":"Shop Now button"},"tv":{"label":"TV / CTV","aspect":"16:9","durations":[10,15,20,30,60],"hook_window_sec":3.0,"max_shot_sec":6.0,"notes":"Broadcast finish. Legal supers must hold long enough to read (min 3s).","cta_style":"End frame with brand, pack shot and URL/QR"}},"hook_types":{"question":"Open on a question the audience is already asking themselves. Must be specific, not rhetorical fluff.","relatable_moment":"Open mid-moment on a situation the audience instantly recognises from their own life.","problem_agitation":"Show the frustration vividly in the first second, then twist the knife once before the turn.","pov":"'POV:' framing. The camera is the viewer, dropped into a specific situation.","bold_statement":"A strong, true statement. Only from verified product facts or the brief - never invented.","myth_bust":"State a common belief, then break it. The 'truth' must be backed by a verified fact.","curiosity_gap":"Show the result or an odd detail first and withhold the explanation.","visual_pattern_interrupt":"An unexpected but real, shootable visual action in frame one. No CGI tricks.","unboxing_reveal":"Hands, real packaging, satisfying reveal of the actual product.","before_after":"A real contrast. Only if the brief allows it and claims are supported.","listicle":"'3 reasons...' / '2 things nobody tells you...' Numbers must match the scenes that follow.","testimonial":"Creator or customer voice speaking from experience. Must be framed as a portrayal unless real.","asmr_sensory":"Texture, sound, pour, click, swatch - the product's real sensory moment as the hook.","challenge_trend":"A platform-native format or trend, adapted to the product without forcing it."},"languages":["English","Hindi","Hinglish"],"formats":[{"id":"house-v1","name":"Script Sheet","version":3},{"id":"brief-v1","name":"Creative Brief + Script","version":1}]}